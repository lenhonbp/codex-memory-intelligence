{
  "name": "codex-memory-intelligence",
  "version": "0.9.1",
  "description": "Local-first project memory, dependency and impact intelligence, evidence-driven change history, and session continuation for AI coding agents.",
  "type": "module",
  "bin": {
    "cmi": "src/cli-entry.js",
    "cmi-mcp": "src/mcp-entry.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.js",
    "quality": "node scripts/quality.js",
    "verify": "npm run check && npm run quality && npm test",
    "benchmark": "node scripts/benchmark.js",
    "benchmark:smoke": "node scripts/benchmark.js --files 120 --json",
    "release:check": "node scripts/verify-release.js",
    "package:smoke": "node scripts/package-smoke.js",
    "prepack": "npm run verify"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "codex",
    "ai-agents",
    "project-memory",
    "dependency-graph",
    "impact-analysis",
    "pre-change-analysis",
    "change-intelligence",
    "change-history",
    "session-intelligence",
    "continuation-intelligence",
    "code-intelligence",
    "project-intelligence",
    "local-first",
    "developer-tools",
    "monorepo"
  ],
  "files": [
    "src",
    "schemas",
    "docs",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lenhonbp/codex-memory-intelligence.git"
  },
  "homepage": "https://github.com/lenhonbp/codex-memory-intelligence#readme",
  "bugs": {
    "url": "https://github.com/lenhonbp/codex-memory-intelligence/issues"
  },
  "author": {
    "name": "Nhơn Lê",
    "url": "https://github.com/lenhonbp"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
