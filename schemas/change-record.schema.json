{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lenhonbp/codex-memory-intelligence/schemas/change-record.schema.json",
  "title": "CMI change record",
  "type": "object",
  "required": ["schemaVersion", "id", "status", "goal", "createdAt", "updatedAt", "before", "observations", "policy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["active", "completed"] },
    "goal": { "type": "string", "minLength": 1, "maxLength": 500 },
    "workspace": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "before": {
      "type": "object",
      "required": ["baseline", "predicted", "historicalEvidence", "attribution"],
      "properties": {
        "baseline": { "type": "object" },
        "predicted": {
          "type": "object",
          "required": ["files", "boundaries", "risks", "verification"],
          "properties": {
            "files": { "type": "array", "maxItems": 160, "items": { "type": "string" } },
            "boundaries": { "type": "array", "maxItems": 30, "items": { "type": "object" } },
            "risks": { "type": "array", "maxItems": 20, "items": { "type": "object" } },
            "verification": { "type": "array", "maxItems": 20, "items": { "type": "object" } }
          },
          "additionalProperties": false
        },
        "memoryCoverage": { "type": ["object", "null"] },
        "provenance": { "type": "object" },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "taskContract": { "$ref": "#/$defs/taskContract" },
        "historicalEvidence": { "type": "object" },
        "attribution": { "enum": ["strong", "limited-preexisting-worktree", "explicit-files-only"] }
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["observedAt", "baseline", "attribution", "observedChangedFiles", "observedBoundaries", "comparison"],
        "properties": {
          "observedAt": { "type": "string", "format": "date-time" },
          "baseline": { "type": "object" },
          "attribution": { "enum": ["strong", "limited-preexisting-worktree", "explicit-files-only"] },
          "observedChangedFiles": { "type": "array", "maxItems": 160, "items": { "type": "string" } },
          "committedFilesSinceStart": { "type": "array", "maxItems": 160, "items": { "type": "string" } },
          "explicitFiles": { "type": "array", "maxItems": 160, "items": { "type": "string" } },
          "ambiguousPreExistingFiles": { "type": "array", "maxItems": 160, "items": { "type": "string" } },
          "observedBoundaries": { "type": "array", "items": { "type": "object" } },
          "unmappedFiles": { "type": "array", "maxItems": 160, "items": { "type": "string" } },
          "unexpectedBoundaries": { "type": "array", "items": { "type": "object" } },
          "comparison": {
            "type": "object",
            "required": ["predictedFileCount", "observedChangedFileCount", "overlapCount", "missedByPrediction", "predictedButUnchanged", "interpretation"],
            "properties": {
              "predictedFileCount": { "type": "integer", "minimum": 0 },
              "observedChangedFileCount": { "type": "integer", "minimum": 0 },
              "overlapCount": { "type": "integer", "minimum": 0 },
              "overlap": { "type": "array", "items": { "type": "string" } },
              "missedByPrediction": { "type": "array", "items": { "type": "string" } },
              "predictedButUnchanged": { "type": "array", "items": { "type": "string" } },
              "changedPathCoverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "predictedScopeTouched": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "pathRecall": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "pathPrecision": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "pathF1": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "interpretation": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "completion": {
      "type": ["object", "null"],
      "properties": {
        "completedAt": { "type": "string", "format": "date-time" },
        "outcome": { "enum": ["succeeded", "failed", "partial", "abandoned", "unknown"] },
        "finalObservation": { "type": "object" },
        "verifications": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["name", "status", "provenance"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 500 },
              "status": { "enum": ["passed", "failed", "skipped", "unknown"] },
              "provenance": { "enum": ["reported", "observed-command"] },
              "kind": { "enum": ["implementation", "behavior", "environment-specific", "external/live", "release"] },
              "evidence": { "type": "string", "maxLength": 500 },
              "command": { "type": "string", "minLength": 1, "maxLength": 500 },
              "exitCode": { "type": "integer" },
              "observedAt": { "type": "string", "format": "date-time" },
              "outputDigest": { "type": "string", "maxLength": 500 }
            },
            "allOf": [
              {
                "if": { "properties": { "provenance": { "const": "observed-command" } }, "required": ["provenance"] },
                "then": { "required": ["command", "exitCode", "observedAt"] }
              }
            ],
            "additionalProperties": false
          }
        },
        "unexpectedImpact": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 500 } },
        "notes": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 500 } },
        "learningCandidates": { "type": "array", "items": { "type": "object" } },
        "policy": { "type": "string" }
      },
      "required": ["completedAt", "outcome", "finalObservation", "verifications", "unexpectedImpact", "notes", "learningCandidates", "policy"],
      "additionalProperties": false
    },
    "progress": {
      "type": ["object", "null"],
      "properties": {
        "pausedAt": { "type": "string", "format": "date-time" },
        "outcome": { "const": "partial" },
        "finalObservation": { "type": "object" },
        "verifications": { "type": "array", "maxItems": 20, "items": { "$ref": "#/properties/completion/properties/verifications/items" } },
        "unexpectedImpact": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 500 } },
        "notes": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 500 } },
        "learningCandidates": { "type": "array", "items": { "type": "object" } },
        "policy": { "type": "string" }
      },
      "required": ["pausedAt", "outcome", "finalObservation", "verifications", "unexpectedImpact", "notes", "learningCandidates", "policy"],
      "additionalProperties": false
    },
    "policy": { "type": "string" }
  },
  "$defs": {
    "taskContract": {
      "type": "object",
      "required": ["version", "goal", "taskKind", "depth", "risk", "successCriteria", "requiredEvidence", "unknowns", "assumptions", "provenance", "policy"],
      "properties": {
        "version": { "const": 1 },
        "goal": { "type": "string", "minLength": 1, "maxLength": 500 },
        "taskKind": { "enum": ["change", "documentation", "investigation", "unknown"] },
        "depth": { "enum": ["light", "standard", "deep"] },
        "risk": { "type": "object" },
        "successCriteria": { "type": "array", "maxItems": 8, "items": { "type": "object" } },
        "requiredEvidence": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["id", "kind", "title", "guidance", "required", "source", "confidence"],
            "properties": {
              "id": { "type": "string" },
              "kind": { "enum": ["implementation", "behavior", "environment-specific", "external/live", "release"] },
              "title": { "type": "string" },
              "guidance": { "type": "string" },
              "required": { "const": true },
              "source": { "type": "string" },
              "confidence": { "enum": ["low", "medium", "high"] }
            },
            "additionalProperties": false
          }
        },
        "unknowns": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "assumptions": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "provenance": { "type": "object" },
        "policy": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
