{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lenhonbp/codex-memory-intelligence/schemas/session-record.schema.json",
  "title": "CMI Session Intelligence Record",
  "type": "object",
  "required": ["schemaVersion", "id", "revision", "status", "goal", "createdAt", "updatedAt", "start", "observations", "close"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["active", "closed"] },
    "goal": { "type": "string", "minLength": 1, "maxLength": 500 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "start": { "type": "object" },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["observedAt", "files", "notes", "accomplished", "blockers", "decisions", "questions"],
        "properties": {
          "observedAt": { "type": "string", "format": "date-time" },
          "files": { "type": "array", "items": { "type": "string" }, "maxItems": 160 },
          "notes": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 40 },
          "accomplished": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 40 },
          "blockers": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 40 },
          "decisions": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 40 },
          "questions": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 40 },
          "state": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "close": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["closedAt", "outcome", "summary", "scope", "current", "findings", "openFindings", "recommendations", "guardrails", "knowledgeCandidates", "handoff", "policy"],
          "properties": {
            "closedAt": { "type": "string", "format": "date-time" },
            "outcome": { "enum": ["succeeded", "partial", "blocked", "investigated", "abandoned", "unknown"] },
            "summary": { "type": "string" },
            "scope": { "type": "object" },
            "current": { "type": "object" },
            "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
            "openFindings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
            "recommendations": { "type": "array", "items": { "$ref": "#/$defs/recommendation" } },
            "guardrails": { "type": "array", "items": { "$ref": "#/$defs/guardrail" } },
            "knowledgeCandidates": { "type": "array", "maxItems": 20 },
            "handoff": { "$ref": "#/$defs/handoff" },
            "policy": { "type": "string" }
          },
          "additionalProperties": true
        }
      ]
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "key", "state", "category", "severity", "title", "detail", "confidence", "evidenceType", "occurrences"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "key": { "type": "string" },
        "state": { "enum": ["open", "resolved", "accepted", "dismissed", "superseded"] },
        "category": { "type": "string" },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "title": { "type": "string" },
        "detail": { "type": "string" },
        "confidence": { "enum": ["high", "medium", "low"] },
        "evidenceType": { "enum": ["observed", "reviewed", "historical-correlation", "inferred"] },
        "evidence": { "type": "array", "items": { "type": "string" }, "maxItems": 50 },
        "relatedFiles": { "type": "array", "items": { "type": "string" }, "maxItems": 50 },
        "sessions": { "type": "array", "items": { "type": "string", "format": "uuid" }, "maxItems": 50 },
        "occurrences": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "recommendation": {
      "type": "object",
      "required": ["id", "priority", "action", "reason", "evidenceType", "evidence", "confidence"],
      "properties": {
        "id": { "type": "string" },
        "priority": { "enum": ["P0", "P1", "P2", "P3"] },
        "action": { "type": "string" },
        "reason": { "type": "string" },
        "evidenceType": { "enum": ["observed", "reviewed", "historical-correlation", "inferred"] },
        "evidence": { "type": "array", "items": { "type": "string" }, "maxItems": 50 },
        "confidence": { "enum": ["high", "medium", "low"] },
        "relatedFindingIds": { "type": "array", "items": { "type": "string" }, "maxItems": 50 }
      },
      "additionalProperties": true
    },
    "guardrail": {
      "type": "object",
      "required": ["id", "rule", "reason"],
      "properties": {
        "id": { "type": "string" },
        "rule": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "required": ["schemaVersion", "sessionId", "generatedAt", "objective", "outcome", "repository", "sessionScope", "accomplished", "decisions", "openQuestions", "completedChanges", "activeChanges", "openFindings", "nextActions", "nextAction", "guardrails", "knowledgeCandidates", "agentInstruction"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "sessionId": { "type": "string", "format": "uuid" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "objective": { "type": "string" },
        "outcome": { "enum": ["succeeded", "partial", "blocked", "investigated", "abandoned", "unknown"] },
        "repository": { "type": "object" },
        "sessionScope": { "type": "array", "items": { "type": "string" }, "maxItems": 80 },
        "accomplished": { "type": "array", "items": { "type": "string" }, "maxItems": 30 },
        "decisions": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
        "openQuestions": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
        "completedChanges": { "type": "array", "maxItems": 20 },
        "activeChanges": { "type": "array", "maxItems": 20 },
        "openFindings": { "type": "array", "items": { "$ref": "#/$defs/finding" }, "maxItems": 20 },
        "nextActions": { "type": "array", "items": { "$ref": "#/$defs/recommendation" }, "maxItems": 10 },
        "nextAction": { "$ref": "#/$defs/recommendation" },
        "guardrails": { "type": "array", "items": { "$ref": "#/$defs/guardrail" }, "maxItems": 12 },
        "knowledgeCandidates": { "type": "array", "maxItems": 20 },
        "agentInstruction": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "active" } } },
      "then": { "properties": { "close": { "type": "null" } } }
    },
    {
      "if": { "properties": { "status": { "const": "closed" } } },
      "then": { "properties": { "close": { "type": "object" } } }
    }
  ],
  "additionalProperties": true
}
