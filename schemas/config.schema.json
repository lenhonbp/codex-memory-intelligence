{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lenhonbp/codex-memory-intelligence/schemas/config.schema.json",
  "title": "CMI configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "maxFileBytes", "maxSourceBytes", "maxGraphFiles", "staleAfterDays", "includeHidden"],
  "properties": {
    "version": { "type": "integer", "minimum": 3 },
    "maxFileBytes": { "type": "integer", "minimum": 1024 },
    "maxSourceBytes": { "type": "integer", "minimum": 1024 },
    "maxGraphFiles": { "type": "integer", "minimum": 1 },
    "staleAfterDays": { "type": "integer", "minimum": 1 },
    "includeHidden": { "type": "boolean" }
  }
}
